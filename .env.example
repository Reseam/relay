# Required. The same secret is set on the Forgejo webhook.
WEBHOOK_SECRET=
# The API's RELAY_SECRET; turns on announcements and requests from the Reseam API
API_SECRET=

# Everything feed
DISCORD_FEED_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_FEED_CHAT=
TELEGRAM_FEED_THREAD=

# Releases feed
DISCORD_RELEASES_WEBHOOK=
# New patch requests, for moderators
DISCORD_REQUESTS_WEBHOOK=
TELEGRAM_RELEASES_CHAT=
# Leave a thread empty to post to a forum group's General topic
TELEGRAM_RELEASES_THREAD=

# Announcements from the Reseam API
DISCORD_ANNOUNCEMENTS_WEBHOOK=
TELEGRAM_ANNOUNCEMENTS_CHAT=
TELEGRAM_ANNOUNCEMENTS_THREAD=
# Installed app (no secret); refresh token from `bun scripts/reddit-auth.ts`
REDDIT_CLIENT_ID=
REDDIT_REFRESH_TOKEN=
REDDIT_SUBREDDIT=reseamapp
# auth_token and ct0 cookies of the logged-in X web session
X_AUTH_TOKEN=
X_CT0=
